# Copy to .env and fill in real values.

# ----- Postgres ----------------------------------------------------------
POSTGRES_USER=preppy
POSTGRES_PASSWORD=preppy
POSTGRES_DB=preppy
POSTGRES_URL=jdbc:postgresql://localhost:5432/preppy

# ----- Redis -------------------------------------------------------------
REDIS_PASSWORD=preppy
REDIS_URL=redis://:preppy@localhost:6379

# ----- Qdrant ------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_USE_TLS=false

# ----- Firebase ----------------------------------------------------------
FIREBASE_PROJECT_ID=preppy-dev
FIREBASE_SERVICE_ACCOUNT_PATH=/etc/preppy/firebase-service-account.json

# ----- LLM ---------------------------------------------------------------
LLM_PROVIDER=openai
LLM_API_KEY=
